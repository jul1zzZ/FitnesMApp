<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessApp.MainPage"
             Title="Тренировки">

    <StackLayout Padding="20">
        <!-- Кнопка для перехода к добавлению тренировки -->
        <Button Text="Добавить тренировку" Clicked="OnAddWorkoutClicked"/>

        <!-- Кнопка для перехода к прогрессу -->
        <Button Text="Перейти к прогрессу" Clicked="OnProgressPageClicked"/>

        <!-- Список тренировок -->
        <CollectionView x:Name="WorkoutList" ItemsSource="{Binding Workouts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Name}" FontAttributes="Bold"/>
                        <Label Text="{Binding Date}"/>
                        <Label Text="{Binding Type}"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>

</ContentPage>
